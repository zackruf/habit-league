rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function profileDoc() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    function profileGroupIds() {
      return profileDoc().data.groupIds;
    }

    function groupExists(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupMember(groupId) {
      return groupExists(groupId) && request.auth.uid in groupDoc(groupId).data.memberIds;
    }

    function isGroupOwner(groupId) {
      return groupExists(groupId) && groupDoc(groupId).data.ownerId == request.auth.uid;
    }

    function hasGroupId(data) {
      return data.groupId is string && data.groupId != '';
    }

    function hasRelatedGroupAccess(data) {
      return data.relatedGroupIds is list
        && data.relatedGroupIds.hasAny(get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.groupIds);
    }

    function isPublicRecord(data) {
      return data.visibility == 'public';
    }

    function isValidRoundFormat(data) {
      return data.format in ['individual', 'scramble2', 'scramble3', 'scramble4'];
    }

    function isValidVisibility(data) {
      return data.visibility in ['public', 'friends'];
    }

    function hasValidPlayerIds(data) {
      return data.playerIds is list
        && request.auth.uid in data.playerIds
        && (
          (data.format == 'individual' && data.playerIds.size() == 1)
          || (data.format == 'scramble2' && data.playerIds.size() == 2)
          || (data.format == 'scramble3' && data.playerIds.size() == 3)
          || (data.format == 'scramble4' && data.playerIds.size() == 4)
        );
    }

    function hasValidPlayerNames(data) {
      return data.playerNames is list
        && data.playerNames.size() == data.playerIds.size();
    }

    function hasValidRelatedGroups(data) {
      return !(data.relatedGroupIds is list)
        || data.relatedGroupIds.size() == 0
        || data.relatedGroupIds.hasOnly(profileGroupIds());
    }

    function isValidRoundCreate(data) {
      return isValidRoundFormat(data)
        && isValidVisibility(data)
        && hasValidPlayerIds(data)
        && hasValidPlayerNames(data)
        && data.createdBy == request.auth.uid
        && data.userId == request.auth.uid
        && data.courseId is string
        && data.holesPlayed in [9, 18]
        && data.totalScore is number
        && hasValidRelatedGroups(data)
        && (
          !hasGroupId(data)
          || isGroupMember(data.groupId)
        );
    }

    function isValidActiveRoundCreate(data) {
      return isValidRoundFormat(data)
        && isValidVisibility(data)
        && hasValidPlayerIds(data)
        && hasValidPlayerNames(data)
        && data.createdBy == request.auth.uid
        && data.courseId is string
        && data.holesPlayed in [9, 18]
        && data.status == 'active'
        && hasValidRelatedGroups(data)
        && (
          !hasGroupId(data)
          || isGroupMember(data.groupId)
        );
    }

    function isRoundParticipant(data) {
      return data.createdBy == request.auth.uid
        || data.userId == request.auth.uid
        || (
          data.playerIds is list
          && request.auth.uid in data.playerIds
        );
    }

    function isChallengeCreator() {
      return isSignedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwnProfile(uid);
      allow update: if isOwnProfile(uid)
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'friendIds',
            'incomingFriendRequestIds',
            'outgoingFriendRequestIds'
          ])
        );
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && (
          isGroupOwner(groupId)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          )
        );

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && isGroupMember(groupId);
      }
    }

    match /challenges/{challengeId} {
      allow read: if isSignedIn()
        && groupExists(resource.data.groupId)
        && (
          groupDoc(resource.data.groupId).data.discoverable == true
          || isGroupMember(resource.data.groupId)
        );
      allow create: if isSignedIn()
        && isChallengeCreator()
        && isGroupMember(request.resource.data.groupId);
      allow update: if isSignedIn()
        && (
          isGroupOwner(resource.data.groupId)
          || resource.data.createdBy == request.auth.uid
        );
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /rounds/{roundId} {
      allow read: if isSignedIn()
        && (
          isPublicRecord(resource.data)
          || isRoundParticipant(resource.data)
          || (
            hasGroupId(resource.data)
            && groupExists(resource.data.groupId)
            && (
              groupDoc(resource.data.groupId).data.discoverable == true
              || isGroupMember(resource.data.groupId)
            )
          )
          || hasRelatedGroupAccess(resource.data)
        );
      allow create: if isSignedIn()
        && isValidRoundCreate(request.resource.data);
      allow update: if isSignedIn()
        && isRoundParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility'])
        && isValidVisibility(request.resource.data);
    }

    match /activeRounds/{activeRoundId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid in resource.data.playerIds
          || resource.data.createdBy == request.auth.uid
          || hasRelatedGroupAccess(resource.data)
        );
      allow create: if isSignedIn()
        && isValidActiveRoundCreate(request.resource.data);
      allow update: if isSignedIn()
        && (
          request.auth.uid in resource.data.playerIds
          || resource.data.createdBy == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'holeScores',
          'activeHoleIndex',
          'status',
          'completedRoundId',
          'updatedAt'
        ]);
    }

    match /roundInvites/{inviteId} {
      allow read: if isSignedIn()
        && (
          resource.data.inviterId == request.auth.uid
          || resource.data.inviteeId == request.auth.uid
        );
      allow create: if isSignedIn()
        && request.resource.data.inviterId == request.auth.uid
        && request.resource.data.inviteeId is string
        && request.resource.data.inviteeId != request.auth.uid
        && request.resource.data.activeRoundId is string
        && request.resource.data.courseId is string
        && isValidRoundFormat(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.roundId == null;
      allow update: if isSignedIn()
        && (
          (
            resource.data.inviteeId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
            && request.resource.data.status in ['accepted', 'declined']
          )
          || (
            resource.data.inviterId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roundId'])
            && request.resource.data.roundId is string
          )
        );
    }

    match /habits/{habitId} {
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isGroupMember(resource.data.groupId)
        );
      allow create: if isSignedIn() && isGroupMember(request.resource.data.groupId);
      allow update: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isGroupOwner(resource.data.groupId)
        );
    }

    match /activities/{activityId} {
      allow read, create, update: if isSignedIn();
    }
  }
}
